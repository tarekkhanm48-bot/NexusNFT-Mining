DB_FILE = "nft_mining_db.json"

def load_db():
    if os.path.exists(DB_FILE):
        with open(DB_FILE, "r") as f:
            return json.load(f)
    return {"users": {}, "ips": {}, "devices": {}}

def save_db(data):
    with open(DB_FILE, "w") as f:
        json.dump(data, f, indent=4)

db = load_db()

def update_balances(user_id):
    user_id = str(user_id)
    if user_id not in db["users"]:
        return
    
    user = db["users"][user_id]
    current_time = time.time()
    last_update = user.get("last_update", current_time)
    elapsed_seconds = current_time - last_update
    
    if elapsed_seconds <= 0:
        return

    # Calculate Free NFT Income (Max 3 days = 259200 seconds)
    free_nft_start = user.get("free_nft_start", 0)
    if free_nft_start > 0 and (current_time - free_nft_start) <= 259200:
        free_income = (0.1 / 86400) * elapsed_seconds
        user["balance"] += free_income

    # Calculate Premium NFT Income (Valid for 30 days = 2592000 seconds)
    for nft_id, purchase_time in user.get("premium_nfts", []):
        if (current_time - purchase_time) <= 2592000:
            daily_rate = NFT_PACKAGES[str(nft_id)]["daily"]
            premium_income = (daily_rate / 86400) * elapsed_seconds
            user["balance"] += premium_income
            
    user["last_update"] = current_time
    save_db(db)

# Commission distributor function for network upgrades
def distribute_commission(path, amount):
    rates = [0.30, 0.10, 0.05, 0.03, 0.02]  # 5-Tier configuration setup
    for i, ref_id in enumerate(path):
        if i >= len(rates):
            break
        if str(ref_id) in db["users"]:
            bonus = amount * rates[i]
            db["users"][str(ref_id)]["balance"] += bonus
    save_db(db)

